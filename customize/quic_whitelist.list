# 苹果生态 (防 iCloud 彻底断流与照片同步卡死)
DOMAIN-SUFFIX,apple.com
# DOMAIN-SUFFIX,icloud.com
DOMAIN-SUFFIX,icloud.com.cn
DOMAIN-SUFFIX,mzstatic.com
DOMAIN-SUFFIX,cdn-apple.com      # 苹果最庞大的全球分发 CDN
DOMAIN-SUFFIX,icloud-content.com # iCloud 数据同步底层核心
DOMAIN-SUFFIX,apple-cloudkit.com
DOMAIN-SUFFIX,aaplimg.com        # 苹果图片与动效资产节点
DOMAIN-SUFFIX,apple.com.cn       # 苹果中国区核心
DOMAIN-SUFFIX,apple-dns.net      # 苹果全球动态 CDN 调度解析
# DOMAIN-SUFFIX,push.apple.com
# DOMAIN-SUFFIX,ls.apple.com

# 谷歌外科手术级放行 (仅限实时通讯，绝不放行视频和 STUN 探针)
# 绝对不加 +.google.com 和 stun.*.google.com (防止真实IP泄露)
# 绝对不加 +.googlevideo.com (逼迫 YouTube 老老实实走 TCP 代理通道，保证 4K 不卡)
# 仅放行以下实时语音/视频会议核心域名，保障跨国开会不断连：
# DOMAIN-SUFFIX,meet.google.com     # Google Meet 会议通道
# DOMAIN-SUFFIX,voice.google.com    # Google Voice 语音电话
# DOMAIN-SUFFIX,telephony.goog      # 谷歌底层语音通信协议
# DOMAIN-SUFFIX,messages.google.com # RCS 实时消息推送
# DOMAIN-SUFFIX,duo.google.com      # 高清视频通话

# 微软与生产力 (防 Teams 会议机械音与更新失败)
DOMAIN-SUFFIX,microsoft.com
DOMAIN-SUFFIX,live.com
DOMAIN-SUFFIX,windows.com
DOMAIN-SUFFIX,microsoftonline.com
DOMAIN-SUFFIX,office.com
DOMAIN-SUFFIX,office365.com
DOMAIN-SUFFIX,skype.com           # Teams 与 Skype 语音底层极度依赖 QUIC
DOMAIN-SUFFIX,teams.microsoft.com # Teams 视频会议核心
DOMAIN-SUFFIX,windowsupdate.com   # Windows 补丁更新分发网络

# 全球主流即时通讯与会议 (防跨国语音/视频通话断流)
DOMAIN-SUFFIX,whatsapp.net       # WhatsApp 语音通话依赖 UDP 穿透
DOMAIN-SUFFIX,zoom.us            # Zoom 视频会议核心
DOMAIN-SUFFIX,webex.com          # 思科 Webex 会议
DOMAIN-SUFFIX,discord.com        # Discord 语音频道 (极其依赖 UDP)
DOMAIN-SUFFIX,discord.gg
DOMAIN-SUFFIX,discordapp.net
DOMAIN-SUFFIX,telegram.org       # TG 语音通话防降级

# 主机与 PC 游戏网络 (三大主机和 Steam 联机必须全放行 UDP)
